option_settings:
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 3
    Availability Zones: Any
    HealthCheckType: ELB
    HealthCheckGracePeriod: 300

  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    UpperThreshold: 70
    UpperBreachScaleIncrement: 1
    LowerThreshold: 30
    LowerBreachScaleIncrement: -1
    BreachDuration: 300
